{
    "compilerOptions": {
        "target": "es2020",
        "module": "commonjs",
        "strict": true,
        "moduleResolution": "node",
        "noImplicitThis": true,
        "alwaysStrict": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "lib": ["es2020", "esnext.asynciterable"],
        "sourceMap": true,
        "typeRoots": ["./node_modules/@types", "./typechain"],
        "types": ["node"],
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": ["**/*.ts"],
    "exclude": [
        "node_modules",
        "example",
        "build",
        "test-tokens",
        // TODO: Remove these excludes after closing https://github.com/skalenetwork/IMA/issues/1720
        "migrations/deploySchain.ts",
        "migrations/upgradeSchain.ts",
        "migrations/transferOwnership.ts",
        "migrations/submitTransactions.ts",
        "migrations/hotfixUpgrade.ts",
        "migrations/generateManifest.ts",
        "gas/calculateGas.ts",
        "migrations/deploySchain.ts"
    ]
}
